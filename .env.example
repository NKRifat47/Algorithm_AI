
# Application Configuration
PORT=8050
NODE_ENV=development
BACKEND_URL=http://localhost:8050
FRONT_END_URL=http://localhost:5173

# Database Configuration (Prisma Connection String)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# JWT (JSON Web Token) Security
JWT_SECRET_TOKEN=your_jwt_secret_token_here
JWT_REFRESH_TOKEN=your_jwt_refresh_token_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://default:your_redis_password_here@localhost:6379

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM=your_email@gmail.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8050/api/user/auth/google/callback

# AI Engine Connection (FastAPI/VPS Service)
AI_ENGINE_URL=http://localhost:8080
# The public origin used for web-based previews of generated code
AI_PREVIEW_PUBLIC_ORIGIN=http://localhost

# Stripe Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database Seeding Configuration (Optional)
# SEED_DATABASE=false
